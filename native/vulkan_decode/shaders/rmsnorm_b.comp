#version 450
// K/V-only batch: y[c,:] = rmsnorm(x[c,:]) * w, one workgroup per column.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer State { uint token; uint pos; uint slot; uint slot2; uint target; uint nidx; uint bn; uint pad_; uint btok[8]; uint bpos[8]; uint bslot[8]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) readonly buffer NW { float nw[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };
layout(push_constant) uniform P { uint K; float eps; } p;
void main() {
    uint c = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    if (c >= bn) return;                               // uniform per workgroup
    float ss = 0.0;
    for (uint i = t; i < p.K; i += 256) { float v = x[c * p.K + i]; ss += v * v; }
    float inv = inversesqrt(wg_sum(ss) / float(p.K) + p.eps);
    for (uint i = t; i < p.K; i += 256) y[c * p.K + i] = x[c * p.K + i] * inv * nw[i];
}
