#version 450
// Token embedding, broadcast to every batch column (the current window and, when active, the shadow window).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer State { uint token; uint pos; uint slot; uint slot2; uint target; uint nidx; uint bn; uint pad_; uint btok[8]; uint bpos[8]; uint bslot[8]; };
layout(std430, binding = 1) readonly buffer E { uint e[]; };
layout(std430, binding = 2) writeonly buffer X { float x[]; };
layout(push_constant) uniform P { uint H; uint ncols; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.H / 2) return;
    vec2 v = unpackHalf2x16(e[token * (p.H / 2) + i]);
    for (uint c = 0; c < p.ncols; ++c) { x[c * p.H + 2 * i] = v.x; x[c * p.H + 2 * i + 1] = v.y; }
}
