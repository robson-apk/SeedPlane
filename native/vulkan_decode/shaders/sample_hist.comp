#version 450
// top-k / top-p sampling, pass 2 of 4: level-1 histogram (1,024 bins over [M - 30T, M], bin 0 just below M) of counts and
// fixed-point probability mass q = exp((l - M)/T) / Z. Workgroup 0 stores M and Z for the later passes.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer State { uint token; uint pos; uint slot; uint slot2; uint target; uint nidx; uint bn; uint pad_;
    uint btok[8]; uint bpos[8]; uint bslot[8]; uint smode; float stemp; uint sseed; uint sctr; uint sampled; uint stopk; float stopp; };
layout(std430, binding = 1) readonly buffer L { float logits[]; };
layout(std430, binding = 2) readonly buffer Part { vec2 part[]; };
layout(std430, binding = 3) buffer Sh { uint sh[]; };
layout(push_constant) uniform P { uint n; uint nparts; } p;
#include "sample_common.glsl"
#include "sample_layout.glsl"
void main() {
    if (smode != 2u) return;
    uint t = gl_LocalInvocationID.x; vec2 mz = reduce_partials(t, p.nparts); float M = mz.x * stemp, Z = mz.y;
    if (gl_WorkGroupID.x == 0u && t == 0u) { sh[S_M] = floatBitsToUint(M); sh[S_Z] = floatBitsToUint(Z); }
    float span = 30.0 * stemp, scale = float(NB) / span; uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_WorkGroupID.x * 256u + t; i < p.n; i += stride) {
        float l = logits[i], d = max(M - l, 0.0);   // M is max(l/T)*T: rounding can put the top token above it
        if (d <= span) {
            uint b = min(NB - 1u, uint(d * scale));
            atomicAdd(sh[H1C + b], 1u); atomicAdd(sh[H1M + b], uint(exp((l - M) / stemp) / Z * FIX));
        }
    }
}
